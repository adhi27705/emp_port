{
  "functions": {
    "api/index.py": {
      "includeFiles": "{app/**,public/**,api/**}"
    }
  },
  "rewrites": [
    {
      "source": "/search",
      "destination": "/api/index.py"
    },
    {
      "source": "/register",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
