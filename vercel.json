{
  "functions": {
    "api/*.py": {
      "includeFiles": "{app/**,api/**}"
    }
  },
  "rewrites": [
    {
      "source": "/search",
      "destination": "/api/search.py"
    },
    {
      "source": "/api/search",
      "destination": "/api/search.py"
    },
    {
      "source": "/register",
      "destination": "/api/register.py"
    },
    {
      "source": "/api/register",
      "destination": "/api/register.py"
    },
    {
      "source": "/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
